{
  "name": "Necokara",
  "description": "Necokara",
  "keywords": [
    "electron",
    "karaoke",
    "nicokara",
    "lyrics",
    "timing",
    "video",
    "subtitles"
  ],
  "homepage": "https://github.com/Chrollis/Necokara#readme",
  "bugs": {
    "url": "https://github.com/Chrollis/Necokara/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chrollis/Necokara.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Necokara Contributors"
  },
  "main": "./.erb/dll/main.bundle.dev.js",
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:dll": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "postinstall": "electron-builder install-app-deps && npm run build:dll",
    "rebuild:all": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --win --publish never && npm run build:dll",
    "package:win": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --win --publish never && npm run build:dll",
    "package:linux": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --linux --publish never && npm run build:dll",
    "package:mac": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --mac --publish never && npm run build:dll",
    "licenses": "generate-license-file --input package.json --output licenses/licenses.txt --overwrite && npx license-checker --production --json > licenses/licenses.json",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "prestart": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.main.dev.ts",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run prestart && npm run start:renderer",
    "start:main": "concurrently -k -P \"cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --watch --config ./.erb/configs/webpack.config.main.dev.ts\" \"electronmon . -- {@}\" --",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true NODE_OPTIONS=\"-r ts-node/register --no-warnings\" webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts"
  },
  "browserslist": [
    "extends browserslist-config-erb"
  ],
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@electron/notarize": "^3.0.0",
    "@mdi/font": "^7.4.47",
    "@radzivon.bartoshyk/zaft": "^0.3.13",
    "@zip.js/zip.js": "^2.8.34",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.3.2",
    "electron-updater": "^6.3.9",
    "jsondiffpatch": "^0.7.6",
    "kuromoji": "^0.1.2",
    "onnxruntime-node": "^1.27.0",
    "pleco-xa": "^2.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@svgr/webpack": "^8.1.0",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.2",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@types/semver": "^7.7.1",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^9.1.2",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "detect-port": "^2.1.0",
    "electron": "^35.0.2",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^4.0.0",
    "electronmon": "^2.0.3",
    "file-loader": "^6.2.0",
    "generate-license-file": "^4.2.1",
    "html-webpack-plugin": "^5.6.3",
    "license-checker": "^25.0.1",
    "mini-css-extract-plugin": "^2.9.2",
    "path-browserify": "^1.0.1",
    "prettier": "^3.5.3",
    "react-refresh": "^0.16.0",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.8.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.98.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1"
  },
  "build": {
    "productName": "Necokara",
    "appId": "com.necokara.app",
    "copyright": "Copyright (C) 2026 Chrollis Phrott",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "extraResources": [],
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "mac": {
      "notarize": false,
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "icons/png/neco-icon-1024.png",
      "artifactName": "Necokara-${version}_macOS.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/neco-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icons/neco-icon.ico",
      "artifactName": "Necokara-Setup-${version}_win64.${ext}"
    },
    "portable": {
      "artifactName": "Necokara-Portable-${version}_win64.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "icons/png/neco-icon-512.png",
      "artifactName": "Necokara-${version}_linux64.${ext}"
    },
    "directories": {
      "app": "release/app",
      "output": "release/build"
    },
    "publish": {
      "provider": "github",
      "owner": "Chrollis",
      "repo": "Necokara"
    },
    "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=14.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=7.x",
      "onFail": "error"
    }
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/**",
      ".erb/dll/**"
    ],
    "logLevel": "quiet"
  }
}
